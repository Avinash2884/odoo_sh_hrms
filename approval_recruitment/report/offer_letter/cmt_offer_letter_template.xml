<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_cmt_offer_letter_template" model="ir.actions.report">
        <field name="name">CMT Offer Letter Template</field>
        <field name="model">hr.contract.salary.offer</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">approval_recruitment.template_cmt_offer_letter_template</field>
        <field name="report_file">approval_recruitment.template_cmt_offer_letter_template</field>
        <field name="print_report_name">'CMT Offer Letter Template'</field>
        <field name="binding_model_id" ref="hr_contract_salary.model_hr_contract_salary_offer"/>
        <field name="binding_type">report</field>
    </record>
    <template id="template_cmt_offer_letter_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="object">
                <t t-call="web.external_layout">

                    <div style="margin: 20px; font-family: 'DM Sans'; font-weight:normal; font-size: 14px; line-height: 1.8;">

                        <!-- Title -->
                        <h3 style="text-align: center; text-decoration: underline; margin-bottom: 30px;">
                            Offer of Internship and Subsequent Appointment
                        </h3>

                        <!-- Date -->
                        <p style="text-align:right; margin-bottom: 25px;">
                            Date: <t t-esc="time.strftime('%d-%m-%Y')"/>
                        </p>

                        <!-- Address -->
                        <p style="margin-bottom: 5px;">To,</p>

                        <p style="margin-bottom: 20px;">
                            <strong><t t-esc="object.applicant_id.partner_name or '-'"/></strong><br/>

                            <t t-if="object.applicant_id.permanent_address">
                                <span t-esc="object.applicant_id.permanent_address or '-'"/><br/>
                            </t>

                            <t t-if="object.applicant_id.pincode">
                                PIN: <span t-esc="object.applicant_id.pincode or '-'"/>
                            </t>
                        </p>

                        <p style="margin-bottom: 20px;">
                            Dear <strong><t t-esc="object.applicant_id.partner_name or '-'"/></strong>,
                        </p>

                        <p style="text-align: justify; margin-bottom: 20px;">
                            We are pleased to offer you a position with
                            <strong><t t-esc="object.company_id.name or '-'"/></strong>,
                            in its <t t-esc="object.company_id.street or '-'"/>
                            <t t-esc="object.company_id.street2 or '-'"/>
                            <t t-esc="object.company_id.city or '-'"/>
                            <t t-esc="object.company_id.state_id.name or '-'"/> -
                            <t t-esc="object.company_id.zip or '-'"/>
                            on the following terms and conditions:
                        </p>

                        <p style="margin-bottom: 10px;">
                            1. <strong>Role:</strong> <t t-esc="object.applicant_id.job_id.name or '-'"/>
                        </p>

                        <p style="margin-bottom: 10px;">
                            2. <strong>Designation:</strong> <t t-esc="object.cmt_designation.name or '-'"/>
                        </p>

                        <p style="margin-bottom: 10px;">
                            3. We would appreciate you joining us on or before
                            <strong>Joining Date:</strong>
                            <t t-if="object.applicant_id.ls_date_of_joining">
                                <t t-esc="object.applicant_id.ls_date_of_joining.strftime('%d-%m-%Y')"/>
                            </t>
                            <t t-else="">-</t>
                        </p>

                        <p style="margin-bottom: 10px;">
                            4.	Compensation: Your Annual Compensation will be INR: Total<strong> Rs.<t t-esc="object.final_yearly_costs"/></strong> Per Annum. Annexure 1 outlines the detailed component-wise stack up.
                        </p>

                        <p>
                            5.	You will be on internship for the first 3 months of engagement. During this internship period you be provided with a stipend of INR 18,000 per month.
                        </p>
                        <p>
                            <strong>
                                6.	CCT/CRT certification within 3 months from date of joining is mandatory for full-time employment confirmation. If certification is not completed, then the Company reserves the right to not extend full-time employment offer.
                            </strong>
                        </p>
                        <p>
                            7.	Post CCT/CRT certification completion, you are eligible for the full salary mentioned in Annexure 1.
                        </p>
                        <div style="page-break-before: always; font-family: 'DM Sans'; font-weight:normal;">
                            <p>
                                The offer stands automatically revoked, not joining as per the indicated timelines. Discussions or attempts to arrive at a revised joining date could be made, but in case no agreement on a date is arrived at, the date indicated in the offer (or last agreed in writing thereafter) would be considered as the date by which the you should join, failing which the offer would automatically stand revoked. While you are at liberty to reject the offer by indicating in writing, the offer can also be revoked at the discretion of the management, before your date of joining.
                            </p>
                            <p style="margin-bottom: 10px;">
                                Acceptance: Your formal acceptance of the terms &amp; conditions of this offer should be confirmed in writing (reply to email/countersigning this Offer Letter) within 3 calendar days.
                            </p>
                            <p style="margin-bottom: 10px;">
                                <strong>
                                    Terms and Conditions of Association:
                                </strong>
                            </p>
                            <p style="margin-bottom: 10px;">
                                The Company may, for business needs, may change your reporting manager, or transfer you to any other office location or function of the Company in India or overseas or to any of its affiliates.
                            </p>
                            <p style="margin-bottom: 10px;">
                                Verification: This offer may be subject to a positive reference check and background screening. In the event that background verification has not been completed to the satisfaction of the Company in its sole discretion or you have been found to have willfully suppressed or forged any piece of information during the course of the interview or employment, the Company reserves the right to cancel this offer letter and terminate any subsequent agreement with immediate effect with written notice to that effect.
                            </p>
                            <p style="margin-bottom: 10px;">
                                Notice period: During this period of internship, the Company may conduct evaluation(s) on functional and behavioral aspects of your role as deemed fit, to ascertain the suitability of the employment.
                            </p>
                            <p style="margin-bottom: 10px;">
                                During this period, the engagement may be ended through a written notification, by giving 15 days’ notice, on either side. The  Company shall be entitled to terminate your engagement at any time by paying you a salary in lieu of notice.
                            </p>
                            <p style="margin-bottom: 10px;">
                                As a confirmed full-time employee, the employment can be terminated by giving 15 days’ notice, on either side. The  Company shall be entitled to terminate your engagement at any time by paying you a salary in lieu of notice.
                            </p>
                            <p style="margin-bottom: 10px;">
                               A detailed Appointment Letter agreement outlining the terms and conditions of your association with the Company will be issued as part of your joining formalities.
                            </p>
                            <p style="margin-bottom: 10px;">
                                During the course of employment with the company, you shall not enter the service or employment, consultancy, full or part time, for any other person or organization, nor shall you carry on or be interested in any business.
                            </p>
                            <p style="margin-bottom: 10px;">
                                You will be governed by the policies of the company as may be applicable from time to time.
                                Your compensation details are personal and must be treated with absolute confidentiality
                            </p>
                            <p style="margin-bottom: 10px;">
                                Documents: On the date of joining, please provide self-attested and dated copies of below (digital version accepted):
                            </p>
                            <ul style="margin-bottom: 10px;">
                                <li>Aadhar card</li>
                                <li>PAN card</li>
                                <li>Driving license (if available) </li>
                                <li>Current / latest employment: Acceptance of Resignation / Relieving letter</li>
                                <li>Previous employment: Experience letters, relieving letters</li>
                                <li>Educational certificates and mark sheets Degree/Diploma, X and XII).</li>
                                <li>Passport-sized photographs</li>
                            </ul>
                            <p style="margin-bottom: 10px;">
                                Looking forward to having you on board and together creating a story!
                            </p>
                            <p style="margin-bottom: 10px;">
                                <strong>For <t t-esc="object.company_id.name or '-'"/></strong>
                            </p>
                            <p style="margin-top: 10px;"><t t-esc="object.applicant_id.job_id.hr_head_name.name or '-'"/></p>
                            <p style="margin-top: 0px;"><t t-esc="object.applicant_id.job_id.hr_description or '-'"/></p>
                        </div>
                        <div style="page-break-before: always; font-family: 'DM Sans'; font-weight:normal;">

                            <p style="text-align: center; text-decoration: underline; margin-bottom: 20px;font-size: 18px;">
                                <strong>Annexure I</strong>
                            </p>
                            <p style="margin-bottom: 10px;">
                                During this internship period you be provided with a stipend of INR 18,000 per month.
                            </p>
                            <p style="margin-bottom: 10px;">
                                Post CCT/CRT certification completion &amp; full-time employment, you will be eligible for the below:
                            </p>
                            <!-- Employee Details -->
                            <p style="margin-bottom: 10px;">Name: <t t-esc="object.applicant_id.partner_name or '-'"/></p>
                            <p>Designation: <t t-esc="object.cmt_designation.name or '-'"/></p>
                            <p>Band: <t t-esc="object.band_id.name or '-'"/></p>
                            <p>Level: <t t-esc="object.level_id.name or '-'"/></p>
                            <p>
                                Date of joining:
                                <t t-esc="object.applicant_id.ls_date_of_joining and object.applicant_id.ls_date_of_joining.strftime('%d-%m-%Y') or '-'"/>
                            </p>

                            <p style="margin-bottom: 10px;">The breakup of the Salary is given below:</p><br></br>

                            <!-- Salary Table -->
                            <table class="table table-bordered" style="width: 80%; margin-top: 5px; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th class="text-start">Particulars</th>
                                        <th class="text-center">Monthly</th>
                                        <th class="text-center">Annual CTC</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Basic Pay + DA</td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.basic_pay or '-'"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.basic_pay_annual or '-'"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>HRA</td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.hra or '-'"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.hra_annual or '-'"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>Special Allowance</td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.special_allowance or '-'"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.special_allowance_annual or '-'"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td><strong>Total Gross Pay</strong></td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.total_gross_pay or '-'"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.total_gross_pay_annual or '-'"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>Employer PF (12%)</td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.employer_pf or '-'"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.employer_pf_annual or '-'"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td><strong>CTC</strong></td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.total_gross_pay or '-'"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.total_gross_pay_annual or '-'"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Notes -->
                            <ul style="margin-top: 15px;">
                                <li>
                                    Taxation: The Income Tax Act as prevailing at the time of employment, will govern the taxation matters. The Company will deduct tax at source as per the prevailing income tax law.
                                </li>
                                <li>
                                    Gratuity and Insurance is over and above CTC.
                                </li>
                                <li>
                                    Variable Performance Pay: Payable annually
                                </li>
                                <li>
                                    Expectations to be measured against clearly defined and mutually agreed goals, reviewed Monthly with manager.
                                </li>
                            </ul>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>