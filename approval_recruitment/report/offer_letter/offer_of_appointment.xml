<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_offer_letter" model="report.paperformat">
        <field name="name">Offer Letter Paperformat</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">45</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">30</field>
        <field name="margin_right">20</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_offer_of_appointment" model="ir.actions.report">
        <field name="name">Full Time Employee Offer Letter Template</field>
        <field name="model">hr.contract.salary.offer</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">approval_recruitment.template_offer_of_appointment</field>
        <field name="report_file">approval_recruitment.template_offer_of_appointment</field>
        <field name="print_report_name">'Full Time Employee Offer Letter'</field>
        <field name="paperformat_id" ref="paperformat_offer_letter"/>
    </record>
    <template id="template_offer_of_appointment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="object">
                <t t-call="approval_recruitment.custom_report_layout">

                    <div style="font-family: 'DM Sans', sans-serif !important; font-weight: 400; font-size: 14px; line-height: 1.8;">

                        <!-- Title -->
                        <h2 style="text-align: center; text-decoration: underline; margin-bottom: 30px;">
                            Offer Letter
                        </h2>

                        <!-- Date -->
                        <p style="text-align:right; margin-bottom: 25px;">
                            Date: <t t-esc="time.strftime('%d-%m-%Y')"/>
                        </p>

                        <!-- Address -->
                        <p style="margin-bottom: 5px;">To,</p>

                        <p style="margin-top: 0px;">
                            <strong><t t-esc="object.applicant_id.partner_name or '-'"/></strong><br/>

                            <t t-if="object.applicant_id.mailing_address">
                                <span t-esc="object.applicant_id.mailing_address or '-'"/><br/>
                            </t>

                            <t t-if="object.applicant_id.pincode">
                                PIN: <span t-esc="object.applicant_id.pincode or '-'"/>
                            </t>
                        </p>

                        <p style="margin-bottom: 20px;">
                            Dear <strong><t t-esc="object.applicant_id.partner_name or '-'"/></strong>,
                        </p>

                        <p style="text-align: justify; margin-bottom: 20px;">
                            We are pleased to offer you a position with
                            <strong><t t-esc="object.company_id.name or '-'"/></strong>,
                            in its <t t-esc="object.company_id.street or '-'"/>
                            <t t-esc="object.company_id.street2 or '-'"/>
                            <t t-esc="object.company_id.city or '-'"/>
                            <t t-esc="object.company_id.state_id.name or '-'"/>
                            <t t-esc="object.company_id.zip or '-'"/>
                            on the following terms and conditions:
                        </p>

                        <p style="margin-bottom: 10px;">
                            1. <strong>Role:</strong> <t t-esc="object.applicant_id.job_id.name or '-'"/>
                        </p>

                        <p style="margin-bottom: 10px;">
                            2. <strong>Designation:</strong> <t t-esc="object.designation.name or '-'"/>
                        </p>

                        <p style="margin-bottom: 10px;">
                            3. We would appreciate you joining us on or before
                            <strong>Joining Date:</strong>
                            <t t-if="object.applicant_id.ls_date_of_joining">
                                <t t-esc="object.applicant_id.ls_date_of_joining.strftime('%d-%m-%Y')"/>
                            </t>
                            <t t-else="">-</t>
                        </p>

                        <p style="margin-bottom: 10px;">
                            4. Compensation: Your Annual Compensation will be INR Total <strong>Rs.<t t-esc="('%.0f' % object.final_yearly_costs) if object.final_yearly_costs or object.final_yearly_costs == 0 else '-'"/></strong> Per Annum, including a Variable Pay <strong>Rs.<t t-esc="('%.0f' % object.variable_pay_ctc) if object.variable_pay_ctc or object.variable_pay_ctc == 0 else '-'"/></strong>. Annexure 1 outlines the detailed component-wise stack up.
                        </p>

                        <p>
                            5.  You will be deputed to <strong><t t-esc="object.offer_hospital_name or '-'"/></strong>, located at <strong><t t-esc="object.offer_hospital_city or '-'"/></strong> for this role.
                        </p>
                        <p>
                           The Company may, for business needs, may change your reporting manager, or transfer you to any other office location or function of the Company in India or overseas or to any of its affiliates.
                        </p>
                        <p>
                            The offer stands automatically revoked, not joining as per the indicated timelines. Discussions or attempts to arrive at a revised joining date could be made, but in case no agreement on a date is arrived at, the date indicated in the offer (or last agreed in writing thereafter) would be considered as the date by which the you should join, failing which the offer would automatically stand revoked. While you are at liberty to reject the offer by indicating in writing, the offer can also be revoked at the discretion of the management, before your date of joining.
                        </p>
                        <p>
                            Acceptance: Your formal acceptance of the terms &amp; conditions of this offer should be confirmed in writing (reply to email/countersigning this Offer Letter) within 3 calendar days.
                        </p>
                        <p>
                            <strong>
                                Terms and Conditions of Association:
                            </strong>
                        </p>
                        <p>
                            Verification: This offer may be subject to a positive reference check and background screening. In the event that background verification has not been completed to the satisfaction of the Company in its sole discretion or you have been found to have willfully suppressed or forged any piece of information during the course of the interview or employment, the Company reserves the right to cancel this offer letter and terminate any subsequent agreement with immediate effect with written notice to that effect.
                        </p>
                    </div>
                    <div style="page-break-before: always; font-family: 'DM Sans', sans-serif !important; font-weight: 400;">
                        <strong>Probation, Confirmation, and Notice period</strong>
                        <p>
                            You will be on probation for a period of 3 months. During this period, the Company may conduct evaluation(s) on functional and behavioral aspects of your role as deemed fit, to ascertain the suitability of the employment.
                        </p>
                        <p>
                            During probation, the employment may be ended through a written notification, by giving <t t-esc="object.offer_letter_notice_period or '-'"/> days’ notice, on either side. The  Company shall be entitled to terminate your employment at any time by paying you a salary in lieu of notice.
                        </p>
                        <p>
                            As a confirmed employee, the employment can be terminated by giving <t t-esc="object.confirmed_notice_period or '-'"/> days’ notice, on either side. The  Company shall be entitled to terminate your engagement at any time by paying you a salary in lieu of notice.
                        </p>
                        <p>
                            A detailed agreement outlining the terms and conditions of your association with the Company will be issued as part of your joining formalities. During the course of employment with the company, you shall not enter the service or employment, consultancy, full or part time, for any other person or organization, nor shall you carry on or be interested in any business.
                        </p>
                        <p>
                            You will be governed by the policies of the company as may be applicable from time to time.Your compensation details are personal and must be treated with absolute confidentiality
                        </p>
                        <p>
                            Documents: On the date of joining, please provide self-attested and dated copies of below (digital version accepted):
                        </p>
                        <ul>
                            <li>Aadhar card</li>
                            <li>PAN card</li>
                            <li>Driving license (if available) </li>
                            <li>Current / latest employment: Acceptance of Resignation / Relieving letter</li>
                            <li>Previous employment: Experience letters, relieving letters</li>
                            <li>Educational certificates and mark sheets Degree/Diploma, X and XII).</li>
                            <li>Passport-sized photographs</li>
                        </ul>

                        <p>
                            Looking forward to having you on board and together creating a story!
                        </p>

                        <p style="margin-top: 40px;">
                            <strong>For <t t-esc="object.company_id.name or '-'"/></strong>
                        </p>
                        <t t-set="hr_head"
                           t-value="env['recruitment.hr.head.details'].search([], limit=1)"/>

                        <div t-if="hr_head.file"
                             style="
                                margin-top: 10px;
                                margin-bottom: 5px;
                            ">

                            <img t-att-src="image_data_uri(hr_head.file)"
                                 alt="HR Head Signature"
                                 style="
                                    max-width: 150px;
                                    max-height: 60px;
                                    object-fit: contain;
                                "/>

                        </div>

                        <p style="margin: 0; padding: 0;">
                            <t t-esc="hr_head.name.name or '-'"/>
                        </p>

                        <p style="margin: 0; padding: 0;">
                            <t t-esc="hr_head.description or '-'"/>
                        </p>
                    </div>
                    <div style="page-break-before: always; font-family: 'DM Sans', sans-serif !important; font-weight: 400;">

                        <div style="page-break-before: always; font-family: 'DM Sans', sans-serif !important; font-weight: 400;">

                            <p style="text-align: center; text-decoration: underline; margin-bottom: 20px;font-size: 18px;">
                                <strong>Annexure I</strong>
                            </p>

                            <!-- Employee Details -->
                            <p>Name: <t t-esc="object.applicant_id.partner_name or '-'"/></p>
                            <p>Designation: <t t-esc="object.designation.name or '-'"/></p>
                            <p>Band: <t t-esc="object.offer_band_id.name or '-'"/></p>
                            <p>Level: <t t-esc="object.offer_level_id.name or '-'"/></p>
                            <p>
                                Date of joining:
                                <t t-esc="object.applicant_id.ls_date_of_joining and object.applicant_id.ls_date_of_joining.strftime('%d-%m-%Y') or '-'"/>
                            </p>

                            <br/>

                            <p>The breakup of the Salary is given below:</p>

                            <!-- Salary Table -->
                            <table class="table table-bordered" style="width: 80%; margin-top: 10px; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th class="text-start">Particulars</th>
                                        <th class="text-center">Monthly</th>
                                        <th class="text-center">Annual CTC</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Basic Pay + DA</td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.basic_pay or '-'"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.basic_pay_annual or '-'"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>HRA</td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.hra or '-'"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.hra_annual or '-'"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>Special Allowance</td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.special_allowance or '-'"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.special_allowance_annual or '-'"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td><strong>Total Gross Pay</strong></td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.total_gross_pay or '-'"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.total_gross_pay_annual or '-'"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>Employer PF (12%)</td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.employer_pf or '-'"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.employer_pf_annual or '-'"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td><strong>CTC</strong></td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.total_gross_pay or '-'"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-esc="'%.2f' % object.total_gross_pay_annual or '-'"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <br/>

                            <!-- Notes -->
                            <ul style="margin-top: 15px;">
                                <li>
                                    Taxation: The Income Tax Act as prevailing at the time of employment, will govern the taxation matters. The Company will deduct tax at source as per the prevailing income tax law.
                                </li>
                                <li>
                                    Gratuity and Insurance is over and above CTC.
                                </li>
                                <li>
                                    If Variable Performance Pay is included: Payable annually with outcomes be measured against clearly defined and mutually agreed goals, reviewed monthly with manager.
                                </li>
                            </ul>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>