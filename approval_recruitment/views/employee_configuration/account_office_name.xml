<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================= -->
    <!-- List View -->
    <!-- ========================= -->
    <record id="view_account_office_name_list" model="ir.ui.view">
        <field name="name">account.office.name.list</field>
        <field name="model">account.office.name</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="account_manager"/>
                <field name="company_id"/>
                <field name="create_uid"/>
                <field name="create_date"/>
                <field name="write_uid"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <!-- ========================= -->
    <!-- Form View -->
    <!-- ========================= -->
    <record id="view_account_office_name_form" model="ir.ui.view">
        <field name="name">account.office.name.form</field>
        <field name="model">account.office.name</field>
        <field name="arch" type="xml">
            <form string="Account Office Name">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="account_manager"/>
                            <field name="external_id" readonly="1" invisible="0"/>
                            <field name="company_id"/>

                        </group>
                        <group>
                            <field name="create_uid" options="{'no_open': True}"/>
                            <field name="create_date"/>
                            <field name="write_uid" options="{'no_open': True}"/>
                            <field name="write_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================= -->
    <!-- Action -->
    <!-- ========================= -->
    <record id="action_account_office_name" model="ir.actions.act_window">
        <field name="name">Account Office Names</field>
        <field name="res_model">account.office.name</field>
        <field name="view_mode">list,form</field>
    </record>



</odoo>
