<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_public_form_inherit_remove_phone" model="ir.ui.view">
        <field name="name">hr.employee.public.form.inherit.remove.phone</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//p[field[@name='work_phone']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Mobile Phone முழு block -->
            <xpath expr="//p[field[@name='mobile_phone']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='job_title']" position="attributes">
                <attribute name="string">Designation</attribute>
            </xpath>

            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="string">Reporting Manager</attribute>
                <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
            </xpath>

            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
            </xpath>

            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="account_office_name_ids" widget="many2many_tags"/>
            </xpath>

            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="ls_role_id" options='{"no_open": True, "no_create": True}'/>
            </xpath>

            <xpath expr="//field[@name='address_id']" position="attributes">
                <attribute name="string">Base Location</attribute>
                <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
            </xpath>

            <xpath expr="//field[@name='work_location_id']" position="attributes">
                <attribute name="string">Deputed Location</attribute>
                <attribute name="options">{'no_open': True, 'no_create': True}</attribute>
            </xpath>

            <xpath expr="//page[@name='received_badges']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='certification']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>


