<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ==================== TREE VIEW ==================== -->

    <record id="view_recruitment_hr_head_details_list"
            model="ir.ui.view">

        <field name="name">recruitment.hr.head.details.list</field>
        <field name="model">recruitment.hr.head.details</field>

        <field name="arch" type="xml">

            <list string="HR Head Details">

                <field name="name"/>
                <field name="description"/>
                <field name="file_name"/>

            </list>

        </field>

    </record>


    <!-- ==================== FORM VIEW ==================== -->

    <record id="view_recruitment_hr_head_details_form"
            model="ir.ui.view">

        <field name="name">recruitment.hr.head.details.form</field>
        <field name="model">recruitment.hr.head.details</field>

        <field name="arch" type="xml">

            <form string="HR Head Details">

                <sheet>

                    <group>

                        <field name="name"/>

                        <field name="description"/>

                        <field name="file"
                               filename="file_name"/>

                        <field name="file_name"
                               invisible="1"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ==================== ACTION ==================== -->

    <record id="action_recruitment_hr_head_details"
            model="ir.actions.act_window">

        <field name="name">HR Head Details</field>
        <field name="res_model">recruitment.hr.head.details</field>
        <field name="view_mode">list,form</field>

    </record>


    <!-- ==================== MENU ==================== -->

    <menuitem id="menu_recruitment_hr_head_details"
              name="HR Head Details"
              parent="hr_recruitment.menu_hr_recruitment_configuration"
              action="action_recruitment_hr_head_details"
              sequence="50"/>

</odoo>