<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_hide_phone" model="ir.ui.view">
        <field name="name">res.users.form.hide.phone</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//h5[field[@name='work_phone']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//h5[field[@name='mobile_phone']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>