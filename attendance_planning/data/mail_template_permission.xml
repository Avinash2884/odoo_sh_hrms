<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 1. Email to Manager when Request is Submitted -->
        <record id="email_template_permission_manager" model="mail.template">
            <field name="name">Permission Request: Notify Manager</field>
            <field name="model_id" ref="model_hr_attendance_permission"/>
            <field name="subject">Permission Request from {{ object.employee_id.name }}</field>
            <field name="email_to">{{ object.employee_id.parent_id.work_email or object.employee_id.parent_id.user_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear <t t-out="object.employee_id.parent_id.name or 'Manager'"/>,<br/><br/>
                    A new 1-hour permission request has been submitted by <strong><t t-out="object.employee_id.name"/></strong> for <strong><t t-out="object.date"/></strong>.<br/><br/>
                    <strong>Reason:</strong> <t t-out="object.reason"/><br/><br/>
                    Please log into Odoo to approve or reject this request.<br/><br/>
                    Thank you.
                </div>
            </field>
        </record>

        <!-- 2. Email to Employee when Approved/Rejected -->
        <record id="email_template_permission_employee" model="mail.template">
            <field name="name">Permission Request: Status Update</field>
            <field name="model_id" ref="model_hr_attendance_permission"/>
            <field name="subject">Permission Request {{ object.state.title() }}</field>
            <field name="email_to">{{ object.employee_id.work_email or object.employee_id.user_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear <t t-out="object.employee_id.name"/>,<br/><br/>
                    Your permission request for <strong><t t-out="object.date"/></strong> has been <strong><t t-out="object.state.title()"/></strong>.<br/><br/>
                    Thank you.
                </div>
            </field>
        </record>

    </data>
</odoo>