<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ═══════════════════════════════════════════════════════════════
         MAIN ATTENDANCE SHEET
    ═══════════════════════════════════════════════════════════════════ -->
    <t t-name="attendance_planning.AttendanceMatrixReport" owl="1">
        <div class="o_attendance_matrix_report h-100 d-flex flex-column">

            <!-- Toolbar -->
            <div class="d-flex align-items-center p-2 border-bottom bg-light flex-wrap gap-2">
                <button class="btn btn-secondary btn-sm" t-on-click="prevMonth">
                    <i class="fa fa-chevron-left"/>
                </button>
                <button class="btn btn-secondary btn-sm" t-on-click="nextMonth">
                    <i class="fa fa-chevron-right"/>
                </button>
                <button class="btn btn-outline-primary btn-sm" t-on-click="goToday">Today</button>
                <h5 class="mb-0 me-2" t-esc="this.monthLabel"/>
                <span class="text-muted small" t-if="state.loading">Loading…</span>

                <!-- Native-style unified Search Bar -->
                <div class="o_amc_searchbar_wrap position-relative ms-2" t-ref="filterRoot">
                    <div class="o_amc_search_box d-flex align-items-center flex-wrap"
                         t-on-click="toggleFilters">
                        <i class="fa fa-search text-muted mx-2"/>

                        <span t-foreach="chips" t-as="chip" t-key="chip.key"
                              class="o_amc_chip">
                            <i t-att-class="'fa ' + chip.icon"/>
                            <span t-esc="chip.label"/>
                            <i class="fa fa-times o_amc_chip_x"
                               t-on-click.stop="() => this.removeChip(chip.key)"/>
                        </span>

                        <input type="text"
                               class="o_amc_search_input flex-grow-1"
                               placeholder="Search employee..."
                               t-att-value="state.searchText"
                               t-on-click.stop=""
                               t-on-input="setSearchText"/>

                        <i class="fa fa-caret-down o_amc_caret"/>
                    </div>

                    <div t-if="state.filtersOpen" class="o_amc_filters_dropdown shadow" t-on-click.stop="">
                        <div class="o_amc_filters_col">
                            <div class="o_amc_filters_col_title">Filters — Shift Type</div>
                            <div class="o_amc_filter_item" t-on-click="() => this.setShiftFilter('all')">
                                <i t-att-class="state.shiftFilter === 'all' ? 'fa fa-check' : ''"/>
                                <span>All</span>
                            </div>
                            <div class="o_amc_filter_item" t-on-click="() => this.setShiftFilter('regular')">
                                <i t-att-class="state.shiftFilter === 'regular' ? 'fa fa-check' : ''"/>
                                <span>Regular</span>
                            </div>
                            <div class="o_amc_filter_item" t-on-click="() => this.setShiftFilter('rotational')">
                                <i t-att-class="state.shiftFilter === 'rotational' ? 'fa fa-check' : ''"/>
                                <span>Rotational</span>
                            </div>

                            <div class="o_amc_filters_col_title mt-2">Filters — Day Type</div>
                            <div class="o_amc_filter_item" t-on-click="() => this.setCodeFilter('all')">
                                <i t-att-class="state.codeFilter === 'all' ? 'fa fa-check' : ''"/>
                                <span>All</span>
                            </div>
                            <div class="o_amc_filter_item" t-on-click="() => this.setCodeFilter('A')">
                                <i t-att-class="state.codeFilter === 'A' ? 'fa fa-check' : ''"/>
                                <span>Attendance</span>
                            </div>
                            <div class="o_amc_filter_item" t-on-click="() => this.setCodeFilter('OT')">
                                <i t-att-class="state.codeFilter === 'OT' ? 'fa fa-check' : ''"/>
                                <span>OT</span>
                            </div>
                            <div class="o_amc_filter_item" t-on-click="() => this.setCodeFilter('EDP')">
                                <i t-att-class="state.codeFilter === 'EDP' ? 'fa fa-check' : ''"/>
                                <span>EDP</span>
                            </div>
                        </div>

                        <div class="o_amc_filters_col">
                            <div class="o_amc_filters_col_title">Group By</div>
                            <div class="o_amc_filter_item" t-on-click="() => this.setGroupBy('shift_type')">
                                <i t-att-class="state.groupBy === 'shift_type' ? 'fa fa-check' : ''"/>
                                <span>Shift Type</span>
                            </div>
                            <!-- Placeholder for future Leave grouping once Time Off is wired in -->
                        </div>
                    </div>
                </div>

                <!-- Legend -->
                <div class="ms-auto d-flex align-items-center gap-2 o_amc_legend flex-wrap">
                    <span class="o_amc_badge o_amc_A">A</span><small>Present</small>
                    <span class="o_amc_badge o_amc_OT">OT</span><small>Overtime</small>
                    <span class="o_amc_badge o_amc_EDP">EDP</span><small>Extra Duty</small>
                    <span class="o_amc_legend_wo_swatch"/><small>Week-off</small>
                </div>
            </div>

            <!-- Grid -->
            <div class="flex-grow-1 overflow-auto">
                <table class="table table-bordered table-sm o_attendance_matrix_table mb-0">
                    <thead class="o_attendance_matrix_head">
                        <tr>
                            <!-- Sticky employee column -->
                            <th class="o_attendance_matrix_emp_col">Employee</th>
                            <t t-foreach="state.days" t-as="day" t-key="day">
                                <th t-att-class="headerCellClass(day)">
                                    <div class="o_amc_day_num" t-esc="dayNumber(day)"/>
                                    <div class="o_amc_day_dow" t-esc="dayLabel(day)"/>
                                </th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Flat rows (no Group By active) -->
                        <t t-if="!groupedEmployees">
                            <t t-foreach="filteredEmployees" t-as="emp" t-key="emp.id">
                                <tr>
                                    <td class="o_attendance_matrix_emp_col fw-bold">
                                        <t t-esc="emp.name"/>
                                        <span t-if="emp.shift_type === 'rotational'"
                                              class="o_amc_shift_pill o_amc_shift_rot ms-1">R</span>
                                        <span t-else="" class="o_amc_shift_pill o_amc_shift_reg ms-1">F</span>
                                    </td>
                                    <t t-foreach="state.days" t-as="day" t-key="day">
                                        <td t-att-class="dataCellClass(emp.id, day)"
                                            t-on-click="() => this.onCellClick(emp.id, emp.name, day)">
                                            <t t-foreach="cellCodes(emp.id, day)" t-as="code" t-key="code">
                                                <div t-att-class="'o_amc_badge o_amc_' + code" t-esc="code"/>
                                            </t>
                                            <t t-if="isWeekoff(emp.id, day) and !cellCodes(emp.id, day).length">
                                                <div class="o_amc_wo_label">WO</div>
                                            </t>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </t>

                        <!-- Grouped rows (Group By: Shift Type active) -->
                        <t t-if="groupedEmployees">
                            <t t-foreach="groupedEmployees" t-as="grp" t-key="grp.key">
                                <tr class="o_amc_group_header_row">
                                    <td t-att-colspan="state.days.length + 1" class="o_amc_group_header">
                                        <t t-esc="grp.label"/>
                                        <span class="text-muted ms-1">(<t t-esc="grp.employees.length"/>)</span>
                                    </td>
                                </tr>
                                <t t-foreach="grp.employees" t-as="emp" t-key="emp.id">
                                    <tr>
                                        <td class="o_attendance_matrix_emp_col fw-bold">
                                            <t t-esc="emp.name"/>
                                            <span t-if="emp.shift_type === 'rotational'"
                                                  class="o_amc_shift_pill o_amc_shift_rot ms-1">R</span>
                                            <span t-else="" class="o_amc_shift_pill o_amc_shift_reg ms-1">F</span>
                                        </td>
                                        <t t-foreach="state.days" t-as="day" t-key="day">
                                            <td t-att-class="dataCellClass(emp.id, day)"
                                                t-on-click="() => this.onCellClick(emp.id, emp.name, day)">
                                                <t t-foreach="cellCodes(emp.id, day)" t-as="code" t-key="code">
                                                    <div t-att-class="'o_amc_badge o_amc_' + code" t-esc="code"/>
                                                </t>
                                                <t t-if="isWeekoff(emp.id, day) and !cellCodes(emp.id, day).length">
                                                    <div class="o_amc_wo_label">WO</div>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </t>
                        </t>
                    </tbody>
                </table>
            </div>

        </div>
    </t>

    <!-- ═══════════════════════════════════════════════════════════════
         DAY-DETAIL POPUP
    ═══════════════════════════════════════════════════════════════════ -->
    <t t-name="attendance_planning.AttendanceDayDetailDialog" owl="1">
        <Dialog title="props.employeeName + ' — ' + props.day" size="'md'">
            <div class="o_attendance_day_detail">

                <!-- Badge row (large) -->
                <div class="mb-3 d-flex gap-2 flex-wrap">
                    <span t-foreach="props.codes" t-as="code" t-key="code"
                          t-att-class="'o_amc_badge o_amc_badge_lg o_amc_' + code"
                          t-esc="code"/>
                </div>

                <!-- Punch table -->
                <t t-if="props.detail.punches and props.detail.punches.length">
                    <h6 class="text-muted text-uppercase small fw-bold mb-2">
                        Punches <span class="text-primary">(IST)</span>
                    </h6>
                    <table class="table table-sm table-bordered mb-3">
                        <thead class="table-light">
                            <tr>
                                <th>Check In</th>
                                <th>Check Out</th>
                                <th>Worked (hrs)</th>
                                <th>Extra (hrs)</th>
                                <th>Approved OT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="props.detail.punches" t-as="p" t-key="p_index">
                                <td><strong t-esc="p.check_in"/></td>
                                <td>
                                    <strong t-esc="p.check_out"/>
                                    <!-- Highlight if still not checked out -->
                                    <span t-if="p.check_out === '-'"
                                          class="badge bg-warning text-dark ms-1">Open</span>
                                </td>
                                <td t-esc="p.worked_hours"/>
                                <td t-esc="p.extra_hours"/>
                                <td>
                                    <span t-if="p.approved_extra_hours > 0"
                                          class="badge bg-warning text-dark"
                                          t-esc="p.approved_extra_hours"/>
                                    <span t-else="" class="text-muted">—</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Summary cards -->
                    <div class="d-flex gap-3 flex-wrap o_amc_summary_row">
                        <div class="o_amc_summary_card">
                            <div class="o_amc_summary_label">Total Worked</div>
                            <div class="o_amc_summary_value">
                                <t t-esc="props.detail.total_worked_hours"/> hrs
                            </div>
                        </div>
                        <div class="o_amc_summary_card">
                            <div class="o_amc_summary_label">Approved OT</div>
                            <div class="o_amc_summary_value o_amc_summary_ot">
                                <t t-esc="props.detail.total_ot_hours"/> hrs
                            </div>
                        </div>
                        <div class="o_amc_summary_card o_amc_summary_payable">
                            <div class="o_amc_summary_label">Total Payable</div>
                            <div class="o_amc_summary_value">
                                <t t-esc="props.detail.total_payable_hours"/> hrs
                            </div>
                        </div>
                    </div>
                </t>

                <!-- EDP section -->
                <t t-if="props.detail.edp">
                    <hr/>
                    <h6 class="text-muted text-uppercase small fw-bold mb-2">EDP — Extra Duty</h6>
                    <table class="table table-sm">
                        <tr>
                            <th>Shift Template</th>
                            <td t-esc="props.detail.edp.shift_template"/>
                        </tr>
                        <tr>
                            <th>Status</th>
                            <td>
                                <span class="badge bg-success"
                                      t-esc="props.detail.edp.state"/>
                            </td>
                        </tr>
                    </table>
                </t>

            </div>
        </Dialog>
    </t>

</templates>