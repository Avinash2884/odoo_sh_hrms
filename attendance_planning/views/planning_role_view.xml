<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_planning_slot_tree_inherit_emp_id" model="ir.ui.view">
        <field name="name">planning.slot.tree.inherit.emp.id</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='start_datetime']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='end_datetime']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='start_datetime']" position="after">
                <field name="shift_date"/>
            </xpath>

            <xpath expr="//field[@name='resource_id']" position="before">
                <field name="ls_employee_id" optional="show" string="Employee ID"/>
            </xpath>

            <xpath expr="//field[@name='resource_id']" position="attributes">
                <attribute name="string">Employee</attribute>
            </xpath>

            <xpath expr="//field[@name='resource_id']" position="after">
                <field name="department_id" optional="show" string="Department"/>
                <field name="calendar_id" optional="show" string="Shift Template"/>
            </xpath>
        </field>
    </record>
    <record id="view_planning_slot_form_clean_custom" model="ir.ui.view">
        <field name="name">planning.slot.form.clean.custom</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='role_id']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='resource_id']" position="attributes">
                <attribute name="string">Employee</attribute>
            </xpath>

            <xpath expr="//field[@name='template_id']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='role_id']" position="after">
                <field name="calendar_id"
                       string="Shift Template"
                       placeholder="Select a shift template..."
                       options="{'no_create': True}"/>
            </xpath>

        </field>
    </record>
</odoo>