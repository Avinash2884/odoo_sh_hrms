<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_groups_privilege_attendance_regularization" model="res.groups.privilege">
        <field name="name">Attendance Regularization</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_attendance_regular_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_attendance_regularization"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_attendance_regular_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="privilege_id" ref="res_groups_privilege_attendance_regularization"/>
        <field name="implied_ids" eval="[(4, ref('group_attendance_regular_user'))]"/>
    </record>

    <record id="group_attendance_regular_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_attendance_regularization"/>
        <field name="implied_ids" eval="[(4, ref('group_attendance_regular_approver'))]"/>
    </record>

<!--    Record Rules-->

    <record id="attendance_regular_rule_user" model="ir.rule">
        <field name="name">Attendance Regularization - Own Records</field>
        <field name="model_id" ref="model_attendance_regular"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('attendance_regularisation.group_attendance_regular_user'))]"/>
    </record>

    <record id="attendance_regular_rule_approver" model="ir.rule">
        <field name="name">Attendance Regularization - Approver All Records</field>
        <field name="model_id" ref="model_attendance_regular"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('attendance_regularisation.group_attendance_regular_approver'))]"/>
    </record>

    <record id="attendance_regular_rule_admin" model="ir.rule">
        <field name="name">Attendance Regularization - Administrator All Records</field>
        <field name="model_id" ref="model_attendance_regular"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('attendance_regularisation.group_attendance_regular_admin'))]"/>
    </record>

</odoo>