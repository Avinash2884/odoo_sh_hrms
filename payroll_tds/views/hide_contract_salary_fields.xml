<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="hr_employee_hide_contract_salary_fields" model="ir.ui.view">
            <field name="name">hr.employee.hide.contract.salary.fields</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr_contract_salary.hr_contract_salary_view_employee_form"/>
            <field name="arch" type="xml">

                <!-- Hide Monthly Cost -->
                <xpath expr="//label[@name='monthly_yearly_costs']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>

                <xpath expr="//div[@name='monthly_yearly_costs']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>

                <!-- Hide Wage on Signature -->
                <xpath expr="//label[@name='wage_on_signature']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>

                <xpath expr="//div[@name='wage_on_signature']" position="attributes">
                    <attribute name="invisible">True</attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>

