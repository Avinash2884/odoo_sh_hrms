<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_hide_work_entry_source" model="ir.ui.view">
        <field name="name">hr.employee.hide.work.entry.source</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_work_entry.hr_employee_view_form"/>
        <field name="arch" type="xml">

            <!-- Hide Schedule separator -->
            <xpath expr="//separator[@name='schedule']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <!-- Hide Work Entry Source -->
            <xpath expr="//field[@name='work_entry_source']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

        </field>
    </record>

</odoo>