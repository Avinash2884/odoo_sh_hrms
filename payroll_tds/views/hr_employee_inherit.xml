<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <record id="hr_employee_inherit_tax_form" model="ir.ui.view">
        <field name="name">hr.employee.inherit.tax.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

           <!-- Hide native Special Allowance label -->
<xpath expr="//label[@for='l10n_in_fixed_allowance']" position="attributes">
    <attribute name="invisible">True</attribute>
</xpath>

<!-- Hide native Special Allowance amount row -->
<xpath expr="//field[@name='l10n_in_fixed_allowance']/ancestor::div[hasclass('o_row')][1]" position="attributes">
    <attribute name="invisible">True</attribute>
</xpath>

<!-- Show the SAME native field immediately after HRA -->
<xpath expr="//field[@name='l10n_in_hra_percentage']/ancestor::div[hasclass('o_row')][1]" position="after">
    <label for="l10n_in_fixed_allowance"/>
    <div class="o_row">
        <field name="l10n_in_fixed_allowance" class="o_hr_narrow_field"/>
        <span>/ month</span>
    </div>
</xpath>
            <!-- Insert custom fields after parent_id -->
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page name="f_and_f_calculation" string="F &amp; F Calculation">
                    <group>
                        <group string="F &amp; F Details">
                            <field name="month"/>
                            <field name="year" options="{'no_format': True}"/>
                            <field name="total_days" readonly="1"/>

                            <field name="wage" readonly="1"/>
                            <field name="l10n_in_basic_salary_amount" readonly="1"/>
                            <field name="per_day_gross" help="Per Day Gross = Monthly Gross (Wage) / Total Days in Month"/>
                            <field name="per_day_basic" help="Per Day Basic = Monthly Basic / Total Days in Month" readonly="1"/>
                            <field name="ff_paid_days1"/>
                            <field name="prorated_salary" help="Prorated Salary = Per Day Gross × Paid Days" readonly="1"/>
                            <field name="el_balance" readonly="1"/>
                            <field name="leave_encashment" help="Leave Encashment = EL Balance × Per Day Basic" readonly="0"/>
                            <field name="l10n_in_gratuity" readonly="1"/>
                            <field name="other_earnings" readonly="1"/>
                            <field name="total_earnings" readonly="1" help="Total Earnings = Prorated Salary + Leave Encashment + Gratuity + Other Earnings"/>
                        </group>
                       <!-- <group string="Notice Period Calculation">
                            <field name="notice_period_days1"/>
                            <field name="notice_served_days"/>
                            <field name="unserved_days" readonly="1"
                                   help="Unserved Days = Notice Period - Notice Served"/>
                            <field name="notice_recovery" readonly="1"
                                   help="Notice Recovery = Unserved Days × Per Day Gross"/>
                        </group> -->
                        <group string="">
                        </group>
                        <group string="Notice Period Calculation">
                            <field name="period_days"/>
                            <field name="notice_served_days"/>

                            <field name="unserved_days" readonly="1"
                                              help="Unserved Days = Notice Period - Notice Served"/>

                            <field name="notice_recovery" readonly="1"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   help="Notice Recovery = Unserved Days × Per Day Gross"/>
                        </group>
                        <group string="Advance Details">
    <field name="total_advance"/>
    <field name="amount_recovered"/>

    <field name="outstanding_amount" readonly="1"
           widget="monetary"
           options="{'currency_field': 'currency_id'}"
           help="Outstanding Amount = Total Advance - Amount Recovered"/>
</group>
                    </group>
                </page>
                <page name="loan_details" string="Loan">
    <group>

        <group string="Loan Information">

            <field name="loan_amount"/>

            <field name="loan_interest"/>

            <field name="loan_months"/>

            <field name="total_payable_amount"
                   readonly="1"/>

            <field name="monthly_installment"
                   readonly="1"/>

        </group>

        <group string="Loan Tracking">

            <field name="paid_installments"/>

            <field name="remaining_balance"
                   readonly="1"/>

        </group>

    </group>
</page>
            </xpath>
            <xpath expr="//div[@name='wage_on_signature']" position="after">
                <field name="payslip_gross_wage"
