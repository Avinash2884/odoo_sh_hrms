<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="hr_employee_view_form_in_inherit" model="ir.ui.view">
    <field name="name">hr.employee.form.in.inherit</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">

        <xpath expr="//group[.//field[@name='l10n_in_lwf_employer_contribution']]" position="after">

            <group col="2">
            <group string="Employee Earnings">

            <label for="variable_pay"/>
                <div class="o_row">
                    <field name="variable_pay" class="o_hr_narrow_field"/>
                    <span>/ month</span>
                </div>

            <label for="employee_incentive"/>
                <div class="o_row">
                    <field name="employee_incentive" class="o_hr_narrow_field"/>
                    <span>/ month</span>
                </div>

            <label for="referral_incentive"/>
                <div class="o_row">
                    <field name="referral_incentive" class="o_hr_narrow_field"/>
                    <span>/ month</span>
                </div>

            <label for="notice_period"/>
                <div class="o_row">
                    <field name="notice_period" class="o_hr_narrow_field"/>
                    <span>/ month</span>
                </div>

            <label for="salary_arrear"/>
                <div class="o_row">
                    <field name="salary_arrear" class="o_hr_narrow_field"/>
                    <span>/ month</span>
                </div>

            <label for="leave_encashment"/>
                <div class="o_row">
                    <field name="leave_encashment" class="o_hr_narrow_field"/>
                    <span>/ month</span>
                </div>

            <label for="hold_salary"/>
                <div class="o_row">
                    <field name="hold_salary" class="o_hr_narrow_field"/>
                     <span>/ month</span>
                </div>

            <label for="other_earnings"/>
                <div class="o_row">
                    <field name="other_earnings" class="o_hr_narrow_field"/>
                    <span>/ month</span>
                </div>

</group>

             <!-- Employee Deductions -->
                <group string="Employee Deductions">
                    <label for="notice_pay_deduction"/>
                    <div class="o_row">
                       <field name="notice_pay_deduction" class="o_hr_narrow_field"/>
                        <span>/ month</span>
                    </div>

                    <label for="loan_deduction"/>
                    <div class="o_row">
                        <field name="loan_deduction" class="o_hr_narrow_field"/>
                        <span>/ month</span>
                    </div>

                    <label for="pf_arrear"/>
                    <div class="o_row">
                        <field name="pf_arrear" class="o_hr_narrow_field"/>
                        <span>/ month</span>
                    </div>

                    <label for="other_deductions"/>
                    <div class="o_row">
                        <field name="other_deductions" class="o_hr_narrow_field"/>
                        <span>/ month</span>
                    </div>
                </group>
            </group>

        </xpath>

    </field>
</record>
</odoo>