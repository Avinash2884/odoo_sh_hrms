<odoo>

    <record id="view_hr_leave_form_inherit_non_working_days" model="ir.ui.view">
        <field name="name">hr.leave.form.non.working.days</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="after">
                <field name="weekend_days" readonly="1"/>
                <field name="public_holiday_days" readonly="1"/>
            </xpath>

            <xpath expr="//button[@name='action_refuse']" position="after">
                <button name="action_print_leave"
                        string="Print"
                        type="object"
                        class="btn-primary"/>
            </xpath>

        </field>
    </record>



</odoo>