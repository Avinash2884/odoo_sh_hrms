    <!-- ========================================================= -->
    <!-- COMP OFF ELIGIBILITY START DATE                            -->
    <!-- ========================================================= -->

    <record id="view_hr_leave_type_comp_off_start_date"
            model="ir.ui.view">

        <field name="name">
            hr.leave.type.comp.off.start.date
        </field>

        <field name="model">hr.leave.type</field>

        <field name="inherit_id"
               ref="hr_holidays.edit_holiday_status_form"/>

        <field name="arch" type="xml">

            <!--
                Odoo 19 standard view:
                Configuration group has id="configuration"
            -->

            <xpath expr="//group[@id='configuration']"
                   position="inside">

                <field name="comp_off_start_date"
                       string="Comp Off Eligibility Start Date"/>

            </xpath>

        </field>

    </record>


</odoo>