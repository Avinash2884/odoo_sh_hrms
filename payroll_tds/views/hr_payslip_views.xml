<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Payslip Form View -->
    <record id="view_hr_payslip_form_inherit_timeoff_balance" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.timeoff.balance</field>
        <field name="model">hr.payslip</field>

        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>

        <field name="arch" type="xml">

            <!-- Statusbar -->
            <xpath expr="//field[@name='state']" position="replace">

                <field name="state"
                       widget="statusbar"
                       statusbar_visible="draft,timeoff_balance,validated,paid"/>

            </xpath>


        </field>
    </record>


    <!-- Payslip List View -->
    <record id="view_hr_payslip_tree_inherit_timeoff_balance" model="ir.ui.view">
        <field name="name">hr.payslip.tree.inherit.timeoff.balance</field>
        <field name="model">hr.payslip</field>

        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='state_display']" position="replace">

                <field
                    name="state_display"
                    widget="badge"
                    decoration-info="state_display == 'draft'"
                    decoration-warning="state_display == 'timeoff_balance'"
                    decoration-success="state_display == 'validated'"
                    decoration-primary="state_display == 'paid'"
                    decoration-danger="state_display == 'error'"
                />

            </xpath>


        </field>
    </record>
      <!-- NEW RECORD -->
    <record id="view_hr_payslip_form_inherit_print_button" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.print.button</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_print_payslip']"
                   position="attributes">
                <attribute name="type">object</attribute>
            </xpath>

        </field>
    </record>
     <record id="view_hr_payslip_form_inherit_total_period_days" model="ir.ui.view">
    <field name="name">hr.payslip.form.inherit.total.period.days</field>
    <field name="model">hr.payslip</field>
    <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
    <field name="arch" type="xml">

        <xpath expr="//field[@name='struct_id']" position="after">
    <field name="total_period_days"/>
            <field name="unpaid_days"/>

            <field name="attendance_days"/>
</xpath>

    </field>
</record>


</odoo>