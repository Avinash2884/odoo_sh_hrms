<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================== -->
    <!-- Salary Revision Wizard -->
    <!-- ====================================================== -->

    <record id="view_salary_revision_wizard_form" model="ir.ui.view">

        <field name="name">salary.revision.wizard.form</field>

        <field name="model">salary.revision.wizard</field>

        <field name="arch" type="xml">

            <form string="Create Revised Wage Details">

                <sheet>

                    <div class="oe_title">
                        <h2>Salary Revision Details</h2>
                    </div>

                    <group col="2">

                        <group string="Revision Information">

                            <field name="employee_id"
                                   invisible="1"/>

                            <field name="effective_date"/>

                            <field name="payout_month"/>

                        </group>

                        <group string="Salary Information">

                            <field name="previous_salary"
                                   readonly="1"/>

                            <field name="new_salary"/>

                        </group>

                    </group>

                </sheet>

                <footer>

                    <button name="action_save_revision"
                            string="Save &amp; Close"
                            type="object"
                            class="btn-primary"/>

                    <button string="Discard"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>


    <!-- ====================================================== -->
    <!-- Wizard Action -->
    <!-- ====================================================== -->

    <record id="action_salary_revision_wizard"
            model="ir.actions.act_window">

        <field name="name">Create Revised Wage Details</field>

        <field name="res_model">salary.revision.wizard</field>

        <field name="view_mode">form</field>

        <field name="view_id"
               ref="view_salary_revision_wizard_form"/>

        <field name="target">new</field>

    </record>

</odoo>