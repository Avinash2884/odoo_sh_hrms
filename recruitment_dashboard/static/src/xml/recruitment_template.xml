<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Root component -->
    <t t-name="RecruitmentDashboard">
        <div class="oh_dashboards container-fluid py-3" style="height: 100vh; overflow-y: auto;">

            <div class="row mb-4">
                <div class="col-12">

                    <div class="row g-3 align-items-end">

                        <!-- From Date -->
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label fw-semibold">From Date</label>
                            <input type="date" class="form-control"
                                   t-model="state.from_date"/>
                        </div>

                        <!-- To Date -->
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label fw-semibold">To Date</label>
                            <input type="date" class="form-control"
                                   t-model="state.to_date"/>
                        </div>

                        <!-- Apply Button (ONLY for Date Filter) -->
                        <div class="col-lg-2 col-md-4">
                            <button class="btn btn-primary w-100"
                                    t-on-click="applyFilter"
                                    style="height:38px;">
                                Apply
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">

                <!-- LEFT SIDE: KPI Cards -->
                <div class="col-lg-4 col-md-12">
                    <div class="row g-3">

                        <!-- Total Applicants -->
                        <div class="col-12">
                            <div class="card kpi-card text-center"
                                 style="background:#FFB3C1;"
                                 t-on-click="openApplicants">
                                <div class="kpi-title">Total Applicants</div>
                                <div class="kpi-value">
                                    <t t-esc="state.total_applicants"/>
                                </div>
                            </div>
                        </div>

                        <!-- Total Jobs -->
                        <div class="col-12">
                            <div class="card kpi-card text-center"
                                 style="background:#BDE0FE;"
                                 t-on-click="openJobs">
                                <div class="kpi-title">Total Jobs</div>
                                <div class="kpi-value">
                                    <t t-esc="state.total_jobs"/>
                                </div>
                            </div>
                        </div>

                        <!-- Total Offers -->
                        <div class="col-12">
                            <div class="card kpi-card text-center"
                                 style="background:#D4F1BE;"
                                 t-on-click="openOffers">
                                <div class="kpi-title">Total Offers</div>
                                <div class="kpi-value">
                                    <t t-esc="state.total_offers"/>
                                </div>
                            </div>
                        </div>

                        <!-- Refused -->
                        <div class="col-12">
                            <div class="card kpi-card text-center"
                                 style="background:#FFE6A7;"
                                 t-on-click="openRefused">
                                <div class="kpi-title">Refused</div>
                                <div class="kpi-value">
                                    <t t-esc="state.refused_count"/>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- RIGHT SIDE: PIE CHART -->
                <div class="col-lg-8 col-md-12">
                    <div class="card shadow-sm p-3 h-100">

                        <!-- Header Row -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0 fw-semibold">Stage-wise Applicants</h6>

                            <!-- SMALL DROPDOWN -->
                            <select class="form-select form-select-sm w-auto"
                                    style="min-width:160px;"
                                    t-on-change="onJobChange">
                                <option value="">All Jobs</option>
                                <t t-foreach="state.jobs" t-as="job" t-key="job.id">
                                    <option t-att-value="job.id">
                                        <t t-esc="job.name"/>
                                        <t t-if="job.department"> - <t t-esc="job.department"/></t>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <canvas t-ref="stagePieChart" style="max-height:380px;"></canvas>

                    </div>
                </div>

            </div>
            <!-- Job summary + Doughnut chart -->
            <div class="row g-4 mt-1">

                <!-- Job summary table -->
                    <div class="col-md-12" style="background:#f8f9fa;">
                        <div class="card shadow-sm border-0 h-100"
                             style="border-radius:16px; background:#ffffff; min-height:460px;border:1px solid rgba(0,0,0,0.12);box-shadow:0 2px 6px rgba(0,0,0,0.08);">
                            <div class="card-header fw-semibold bg-white border-bottom"
                                 style="border-top-left-radius:16px;background:#f1f3f5; border-top-right-radius:16px;">
                                Job-wise Recruitment Summary
                            </div>
                            <div class="table-responsive"
                                 style="max-height: 360px; overflow-y: auto; overflow-x: auto;background:#ffffff;">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light sticky-top"
                                           style="top: 0; z-index: 1; border-bottom: 2px solid #ccc;background:#f8f9fa;">
                                        <tr>
                                            <th>Job Positions</th>
                                            <th class="text-center">Total Vacancies</th>
                                            <th class="text-center">Total Applicants</th>
                                            <th class="text-center">Contract Offered</th>
                                            <th class="text-center">Contract Accepted</th>
                                            <th class="text-center">Contract Expired</th>
                                            <th class="text-center">Contract Refused</th>
                                            <th class="text-center">Contract Cancelled</th>
                                            <th class="text-center">No Shown</th>
                                            <th class="text-center">Applicant Refused</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.job_summary" t-as="job" t-key="job.job_id + '_' + job_index">
                                            <tr>
                                                <!--Job Position-->
                                                <td class="fw-semibold"><t t-esc="job.job_name"/></td>

                                                <!--Total Vacancies-->
                                                <td class="text-center"><t t-esc="job.target"/></td>

                                                <!--Total Applicants-->
                                                <td class="text-center"><t t-esc="job.total_applicants"/></td>

                                                <!--Contract Offered-->
                                                <td class="text-center"><t t-esc="job.contract_offered"/></td>

                                                <!--Contract Accepted-->
                                                <td class="text-center"><t t-esc="job.contract_accepted"/></td>

                                                <!--Contract Expired-->
                                                <td class="text-center"><t t-esc="job.total_offers"/><t t-esc="job.contract_expired"/></td>

                                                <!--Contract Refused-->
                                                <td class="text-center"><t t-esc="job.total_offers"/><t t-esc="job.contract_refused"/></td>

                                                <!--Contract Cancelled-->
                                                <td class="text-center"><t t-esc="job.total_offers"/><t t-esc="job.contract_cancelled"/></td>

                                                <!--No Shown-->
                                                <td class="text-center"><t t-esc="job.not_shown"/></td>

                                                <!--Refused-->
                                                <td class="text-center"><t t-esc="job.refused_offers"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                <!-- Doughnut chart -->
<!--                <div class="col-md-4">-->
<!--                    <div class="card shadow-sm border-0 h-100"-->
<!--                         style="border-radius:16px; background:#ffffff;">-->
<!--                        <div class="card-header fw-semibold bg-white border-bottom"-->
<!--                             style="border-top-left-radius:16px; border-top-right-radius:16px;">-->
<!--                            Selection Overview-->
<!--                        </div>-->
<!--                        <div class="card-body d-flex justify-content-center align-items-center" style="padding: 2rem; min-height: 400px;">-->
<!--                            <canvas t-ref="jobPieChart" style="max-width: 100%; max-height: 300px;"></canvas>-->
<!--                        </div>-->
<!--                    </div>-->
<!--                </div>-->

            </div>
        </div>
    </t>
</templates>
