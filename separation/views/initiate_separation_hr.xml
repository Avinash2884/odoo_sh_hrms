<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_initiate_separation_hr_form" model="ir.ui.view">
        <field name="name">initiate.separation.hr.form</field>
        <field name="model">initiate.separation.hr</field>
        <field name="arch" type="xml">
            <form string="Initiate Separation (HR)">
                <header>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="ls_employee_id" readonly="1"/>
                            <field name="ls_designation_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="joining_date_recruit" readonly="1"/>
                            <field name="last_working_date"/>
                            <field name="resignation_reason"/>
                            <field name="detailed_reason" placeholder="Enter detailed reason..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_initiate_separation_hr_tree" model="ir.ui.view">
        <field name="name">initiate.separation.hr.list</field>
        <field name="model">initiate.separation.hr</field>
        <field name="arch" type="xml">
            <list string="HR Separation">
                <field name="employee_id"/>
                <field name="ls_employee_id"/>
                <field name="department_id"/>
                <field name="last_working_date"/>
                <field name="resignation_reason"/>
            </list>
        </field>
    </record>
    <record id="action_initiate_separation_hr" model="ir.actions.act_window">
        <field name="name">HR Separation</field>
        <field name="res_model">initiate.separation.hr</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>