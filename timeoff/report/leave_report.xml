<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_leave" model="ir.actions.report">
    <field name="name">Leave Report</field>
    <field name="model">hr.leave</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">timeoff.leave_report_template</field>
    <field name="report_file">timeoff.leave_report_template</field>
    <field name="binding_model_id" ref="hr_holidays.model_hr_leave"/>
    <field name="binding_type">report</field>
    </record>

<template id="leave_report_template">
    <t t-call="web.external_layout">
        <main>
            <t t-foreach="docs" t-as="doc">
                <div class="page">

                    <!-- Title -->
                    <h2 style="text-align:center; margin-bottom: 20px;">
                        Leave Request
                    </h2>

                    <!-- Employee Info -->
                    <div style="line-height: 1.8; font-size: 14px;">

                        <p>
                            <strong>Employee:</strong>
                            <t t-esc="doc.employee_id.sudo().name"/>
                        </p>

                        <p>
                            <strong>Department:</strong>
                            <t t-esc="doc.employee_id.sudo().department_id.name"/>
                        </p>

                        <p>
                            <strong>Leave Type:</strong>
                            <t t-esc="doc.holiday_status_id.name"/>
                        </p>

                        <p>
                            <strong>Duration:</strong>
                            <t t-esc="doc.request_date_from"/>
                            to
                            <t t-esc="doc.request_date_to"/>
                            (<t t-esc="doc.number_of_days"/> days)
                        </p>

                    </div>

                    <br/>

                    <!-- Reason -->
                    <div style="font-size: 14px;">
                        <strong>Reason:</strong>
                        <p style="margin-top:5px;">
                            <t t-esc="doc.name"/>
                        </p>
                    </div>

                    <br/><br/>

                    <!-- Signature Section -->
                    <div style="margin-top: 60px;">

                        <table style="width:100%; text-align:center; border:none;">
                            <tr>
                                <td style="width:50%;">
                                    <div style="border-top: 1px solid black; width: 60%; margin: auto;"></div>
                                    <p>Employee Signature</p>
                                </td>

                                <td style="width:50%;">
                                    <div style="border-top: 1px solid black; width: 60%; margin: auto;"></div>
                                    <p>Approving Authority</p>
                                </td>
                            </tr>
                        </table>

                    </div>

                </div>
            </t>
        </main>
    </t>
</template>
</odoo>